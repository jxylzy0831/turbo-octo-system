    },
    {
      "para_index": 109,
      "text": "\u7b2c\u4e94\u5e55",
      "style": "Normal"
    },
    {
      "para_index": 113,
      "text": "\u5927\u5c60\u6740\u7ed3\u675f\u4e86\uff0c\u6bcf\u4e2a\u4eba\u5fc3\u4e0a\u7684\u4f24\u75a4\u5374\u8fdc\u8fdc\u6ca1\u6709\u6108\u5408\u3002",
      "style": "Normal"
    },
    {
      "para_index": 116,
      "text": "\u4f60\u5c06\u5343\u79a7\u5e74\u90a3\u573a\u5c60\u6740\u91cc\uff0c\u6700\u75db\u82e6\u7684\u7ecf\u5386\u5168\u90e8\u57cb\u85cf\u5728\u5fc3\u5e95\u3002 \u4f60\u5ffd\u89c6\u3001 \u9003\u907f\u3001\u5426\u5b9a\u73b0\u5b9e\uff0c\u53ef\u8bb0\u5fc6\u5c31\u5728\u90a3\u91cc\u3002",
      "style": "Normal"
    },
    {
      "para_index": 125,
      "text": "\u5927\u5c60\u6740\u7ed3\u675f\u540e\u7684\u4e00\u5e74\u5de6\u53f3\uff0c\u4f60\u88ab\u5965\u4e01\u4ece\u96be\u6c11\u8425\u5e26\u51fa\uff0c\u4ed6\u95ee\u4f60\u60f3\u4e0d \u60f3\u62a5\u4ec7\uff0c\u4f60\u70b9\u5934\uff0c\u4e8e\u662f\u4ed6\u5e26\u4f60\u52a0\u5165\u4e86\u3010\u6012\u6cb3\u3011\u3002",
      "style": "Normal"
    },
    {
      "para_index": 127,
      "text": "\u6012\u6cb3\u662f\u5927\u5c60\u6740\u4e00\u5e74\u540e\u6210\u7acb\u7684\u6740\u624b\u7ec4\u7ec7\u3002",
      "style": "Normal"
    },
    {
      "para_index": 128,
      "text": "\u4ee5\u72c2\u8349\u5e2e\u4e3a\u524d\u8eab\uff0c\u6210\u5458\u90fd\u662f\u5927\u5c60\u6740\u4e2d\u7684\u5e78\u5b58\u8005\u3002",
      "style": "Normal"
    },
    {
      "para_index": 132,
      "text": "\u4f60\u4eec\u6bcf\u4e2a\u4eba\uff0c\u90fd\u5bf9\u7b56\u5212\u5927\u5c60\u6740\u7684\u59cb\u4f5c\u4fd1\u8005\u6709\u7740\u5f88\u5f3a\u7684\u590d\u4ec7\u6267\u5ff5\uff0c \u76ee\u6807\u662f\u6740\u5149\u90a3\u4e9b\u7b56\u5212\u8005\u3002",
      "style": "Normal"
    },
    {
      "para_index": 153,
      "text": "\u5927\u5c60\u6740\u7ed3\u675f\u540e\uff0c\u6709 \u4e00 \u4e9b\u201c\u5ef6\u8fdf\u201d\u7684\u624b\u4e0b\u4ecd\u7136\u5728\u9003\u7a9c\u3002",
      "style": "Normal"
    },
    {
      "para_index": 164,
      "text": "\u7136 \u540e \uff0c\u4f60\u56de\u5230\u5bf9\u9762\u7684\u5c71\u4e18\u4e0a\u9759\u9759\u7b49\u5f85\u3002",
      "style": "Normal"
    },
    {
      "para_index": 169,
      "text": "\u5e03\u96f7\u8bfa\u8fd9\u4e2a\u5b63\u8282\u7684\u591c\u665a\uff0c\u5c3d\u7ba1\u6ca1\u6709\u767d\u65e5\u7684\u70c8\u65e5\uff0c\u7a7a\u6c14\u4e2d\u4e5f\u4f9d\u7136\u5f25 \u6f2b\u7740 \u4e00\u80a1 \u96be \u4ee5 \u540d\u72b6\u7684\u71e5\u70ed\u3002",
      "style": "Normal"
    },
    {
      "para_index": 170,
      "text": "\u90a3 \u4e9b \u6e05\u6d01\u5242\u4e2d\u7684\u5316\u5b66\u6210\u5206\u5927\u6982\u5df2\u7ecf\u4e0e\u7a7a\u6c14\u4e2d\u7684\u6c34\u6c7d\u7ed3\u5408\uff0c\u5f62\u6210\u4e86 \u4e00 \u5c42\u51e0\u4e4e\u770b\u4e0d\u89c1\u7684\u8584\u96fe\u3002",
      "style": "Normal"
    },
    {
      "para_index": 171,
      "text": "\u50cf \u6b7b \u795e \u7684 \u9762 \u7eb1 \uff0c\u7f13\u7f13\u98d8\u6d6e\u4e8e\u533b\u9662\u7684\u7a7a\u6c14\u4e2d\u3002 \u5f88\u7f8e\u4e3d\u3002",
      "style": "Normal"
    },
    {
      "para_index": 173,
      "text": "\u4f60\u62ff\u51fa\u671b\u8fdc\u955c\u8c03\u6574\u7126\u8ddd\uff0c\u89c2\u5bdf\u7740\u533b\u9662\u91cc\u4e00\u5207\u3002 \u8d1d\u96f7\u5e3d\u7684\u8eab\u5f71\u663e\u5f97\u683c\u5916\u9192\u76ee\u3002",
      "style": "Normal"
    },
    {
      "para_index": 185,
      "text": "\u4ed6\u4eec\u88ab\u8fd9\u7a81\u5982\u5176\u6765\u7684\u95ee\u5019\u60ca\u6270\uff0c\u9762\u9762\u76f8\u89d1\u3002",
      "style": "Normal"
    },
    {
      "para_index": 186,
      "text": "\u8bb8\u591a\u4eba\u4e0b\u610f\u8bc6\u5730\u60f3\u8981\u5f00\u7a97\uff0c\u5374\u53d1\u73b0\u65e0\u6cd5\u6253\u5f00\u3002",
      "style": "Normal"
    },
    {
      "para_index": 187,
      "text": "\u8d1d\u96f7\u5e3d\u4fbf\u5e26\u7740\u51e0\u4e2a\u4eba\u4e0a\u4e86\u9633\u53f0\u9876\u697c\uff0c\u7528\u671b\u8fdc\u955c\u770b\u7740\u4f60\u3002\u6709\u51e0\u4e2a\u4e0d",
      "style": "Normal"
    },
    {
      "para_index": 189,
      "text": "\u5f00\u4ec0\u4e48\u73a9\u7b11\uff0c\u8fd9\u4e48\u8fdc\u7684\u8ddd\u79bb\uff0c\u80fd\u6253\u4e2d\u5c31\u89c1\u9b3c\u4e86\u3002",
      "style": "Normal"
    },
    {
      "para_index": 192,
      "text": "\u7537\u4eba\u554a\uff0c\u5c31\u662f\u559c\u6b22\u6b3a\u9a97\u81ea\u5df1\u3002",
      "style": "Normal"
    },
    {
      "para_index": 203,
      "text": "\u201c \u4ec0 \u4e48 \u5de5 \u5177 ? \u600e \u4e48 ? \u4f60 \u4e70 \u4e86 \u4e00 \u679a \u706b \u7bad \u70ae \u5417 ? \u201d \u8d1d \u96f7 \u5e3d\u8bdd\u97f3\u521a\u843d\uff0c\u4ed6\u8eab\u8fb9\u7684\u4eba \u4e00 \u54c4\u800c\u7b11\u3002",
      "style": "Normal"
    }
  ],
