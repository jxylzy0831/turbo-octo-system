    {
      "para_index": 76,
      "text": "\u6d41\u53d9\u4e8b",
      "style": "Normal"
    },
    {
      "para_index": 80,
      "text": "\u7b2c\u4e03\u5e55",
      "style": "Normal"
    },
    {
      "para_index": 86,
      "text": "\u4f60\u4eec\u518d\u770b\u5411\u7a97\u5916\u65f6\uff0c\u5929\u5df2\u7ecf\u4eae\u4e86\u3002",
      "style": "Normal"
    },
    {
      "para_index": 90,
      "text": "\u7a0b\u807f\u6000\u62ff\u51fa\u83b1\u8bfa\u5bb6\u65cf\u7eaa\u5ff5\u6d3b\u52a8\u7684\u573a\u5730\u5730\u56fe\uff0c\u90a3\u662f\u4e00\u4e2a\u540c\u5fc3\u5706\u5f62\u72b6",
      "style": "Normal"
    },
    {
      "para_index": 93,
      "text": "\u5185\u573a\u7684\u5c0f\u5706\u91cc\uff0c\u5c06\u5750\u6ee1\u540d\u6d41\u3001\u653f\u8981\u3001\u8bb0\u8005\uff0c\u5e76\u4e0d\u5141\u8bb8\u643a\u5e26\u6b66\u5668\u3002",
      "style": "Normal"
    },
    {
      "para_index": 97,
      "text": "\u4f60\u4eec \u7684 \u8ba1 \u5212 \u5982 \u4e0b\u2014\u2014",
      "style": "Normal"
    },
    {
      "para_index": 98,
      "text": "\u5f00\u5e55\u5f0f \u6b63 \u5f0f \u5f00 \u59cb \u540e \uff0c\u5965\u4e01\u5c06\u5e26\u7740\u6240\u6709\u4eba\u9a7b\u5b88\u5728\u56de\u5eca\u4e0a\uff0c\u4e0d\u4f1a\u8ba9\u4efb \u4f55 \u4e00 \u4e2a\u6301\u67aa\u8005\u8fdb \u53bb \u6253\u65ad\u4f60\u4eec\u7684\u53d1\u8a00\uff0c\u4e5f\u4e0d\u4f1a\u653e\u4efb\u4f55\u4e00\u4e2a\u4eba\u51fa\u53bb\u3002",
      "style": "Normal"
    },
    {
      "para_index": 99,
      "text": "\u5965\u4e01\u8bf4\uff1a\u201c\u7b49\u7740\u5427\uff0c\u6211\u8fd9\u4e00\u751f\u53d8\u8fc7\u5f88\u591a\u6b21\u9b54\u672f\uff0c\u5f88\u591a\u90fd\u662f\u5931\u8d25\u4e86\uff0c \u8fd9 \u4e00 \u6b21 \uff0c\u6211\u4f1a\u7ed9\u4f60\u4eec\u53d8\u4e00\u4e2a\u6700\u6210\u529f\u7684\u9b54\u672f\u3002\u201d",
      "style": "Normal"
    },
    {
      "para_index": 106,
      "text": "\u83b1\u8bfa\u5bb6\u65cf\u81f4\u8f9e\u4ee5\u540e\uff0c\u848b\u4f2f\u9a7e\u4f5c\u4e3a\u7f2a\u5bb6\u5bb6\u4e3b\uff0c\u83b1\u8bfa\u5bb6\u65cf\u7684\u8d44\u6df1\u5408\u4f5c \u4f19\u4f34\u4f1a\u7b2c\u4e00\u4e2a\u4e0a\u53bb\u81f4\u8f9e\u3002",
      "style": "Normal"
    },
    {
      "para_index": 107,
      "text": "\u4ed6\u4f1a\u5728\u53d1\u8a00\u4e2d\u76f4\u63a5\u516c\u5f00\u83b1\u8bfa\u5bb6\u65cf\u548c\u7f2a\u5bb6\u7684\u519b\u706b\u751f\u610f\u3002",
      "style": "Normal"
    },
    {
      "para_index": 116,
      "text": "\u547d\u8fd0\u5bf9\u4f60\u4eec\u8d76\u5c3d\u6740\u7edd\uff0c\u4f60\u4eec\u504f\u8981\u4e3a\u81ea\u5df1\u3001\u4e3a\u53d7\u5bb3\u8005\u6740\u51fa\u4e00\u6761\u8840\u8def\u3002",
      "style": "Normal"
    },
    {
      "para_index": 129,
      "text": "\u201c\u4f60\u4eec\u4e0d\u89c9\u5f97\uff0c\u8fd9\u4e2a\u5185\u5706\u4e0e\u5916\u5706\u4e4b\u95f4\u7684\u56de\u5eca\u50cf\u4ec0\u4e48\u5417?\u201d \u201c\u50cf\u53d7\u63a7\u71c3\u70e7\u65f6\uff0c\u63d0\u524d\u89c4\u5212\u7684\u9632\u706b\u5e26\u3002\u201d",
      "style": "Normal"
    },
    {
      "para_index": 130,
      "text": "\u5965\u4e01\u548c\u6012\u6cb3\u5728\u56de\u5eca\u4e0a\uff0c\u4f5c\u4e3a\u9694\u79bb\u5e26\uff0c\u907f\u514d\u83b1\u8bfa\u5bb6\u65cf\u7684\u6301\u67aa\u8005\u8fdb\u5165 \u4f60\u4eec\u660e\u5929\u8981\u5ba3\u5e03\u771f\u76f8\u7684\u5185\u5706\u3002",
      "style": "Normal"
    },
    {
      "para_index": 134,
      "text": "\u4ed6\u4eec\uff0c\u5c06\u4f1a\u4fdd\u62a4\u4f4f\u4f60\u4eec\u5373\u5c06\u79cd\u690d\u7684\u771f\u76f8\u4e4b\u6811\u3002",
      "style": "Normal"
    },
    {
      "para_index": 179,
      "text": "-\u505c\u4e0b\u6765\uff0c\u8bf7\u5728\u8fd9\u91cc\u505a\u597d\u51c6\u5907-",
      "style": "Normal"
    },
    {
      "para_index": 183,
      "text": "\u65e0\u6570\u7684\u94c1\u8bc1\u843d\u4e0b\uff0c\u4f1a\u573a\u4e00\u7247\u54d7\u7136\u3002",
      "style": "Normal"
    },
    {
      "para_index": 189,
      "text": "\u821e\u53f0\u7684\u5899\u58c1\u4e0a\u7a81\u7136\u95ea\u51fa\u4e00\u9053\u6697\u95e8\uff0c\u745e\u6cd5 \u00b7 \u83b1\u8bfa\u548c\u83b1\u8bfa\u5bb6\u65cf\u51e0\u4e2a\u5173",
      "style": "Normal"
    },
    {
      "para_index": 192,
      "text": "\u5373\u4f7f\u4f60\u4eec\u5feb\u901f\u8d76\u8fc7\u53bb\uff0c\u8fd8\u662f\u6ca1\u80fd\u963b\u6b62\u3002",
      "style": "Normal"
    },
    {
      "para_index": 193,
      "text": "\u8fd9\u5927\u6982\u662f\u4ed6\u4eec\u65e9\u5c31\u8bbe\u8ba1\u597d\u7684\u9003\u751f\u901a\u9053\uff0c\u8fde\u95e8\u90fd\u662f\u52a0\u539a\u7684\uff0c\u5bfb\u5e38\u67aa \u652f\u6839\u672c\u6253\u4e0d\u7a7f\u3002",
      "style": "Normal"
    },
    {
      "para_index": 194,
      "text": "\u771f\u4e0d\u6127\u662f\u83b1\u8bfa\u5bb6\u65cf\uff0c\u672a\u96e8\u7ef8\u7f2a\u3001\u72e1\u5154\u4e09\u7a9f\u3002",
      "style": "Normal"
    }
  ],
